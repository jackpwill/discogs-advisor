# Anthropic API (the reasoning layer) — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the model. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Discogs API credentials — create an app at https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=your_consumer_key_here
DISCOGS_CONSUMER_SECRET=your_consumer_secret_here
DISCOGS_ACCESS_TOKEN=your_access_token_here
DISCOGS_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Whose collection to analyze
DISCOGS_USERNAME=your_discogs_username

# Optional: point at an existing discogs-tracker database (same schema) to reuse
# price history already collected over time. Defaults to a local advisor.db.
# DISCOGS_DB_PATH=/path/to/discogs_tracker.db
